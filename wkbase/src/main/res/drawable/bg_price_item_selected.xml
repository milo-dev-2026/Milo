<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <gradient
                android:startColor="@color/ffffeeda"
                android:endColor="@color/bafdfdfd"
                android:angle="135"
                android:type="linear"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1dp"
                android:color="#ffdfd3ab"/>
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/white_191919"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/_33000000"/>
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp"/>
        </shape>
    </item>
</selector>
