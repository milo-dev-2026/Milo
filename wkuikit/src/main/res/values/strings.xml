    <!-- 常见问题 -->
    <string name="faq_q1">如何修改登录密码？</string>
    <string name="faq_a1">进入「安全中心」>「修改密码」，验证身份后即可设置新密码。</string>
    <string name="faq_q2">如何绑定/换绑手机号？</string>
    <string name="faq_a2">进入「安全中心」>「安全账号」>「绑定手机」，验证身份后输入新手机号并完成验证即可。</string>
    <string name="faq_q3">聊天记录可以备份吗？</string>
    <string name="faq_a3">可以。进入「设置」>「聊天记录备份」，选择备份到云端或本地。</string>
    <string name="faq_q4">如何开启深色模式？</string>
    <string name="faq_a4">进入「设置」>「通用设置」>「深色模式」，选择开启即可。</string>
    <string name="faq_q5">忘记锁屏密码怎么办？</string>
    <string name="faq_a5">进入「安全中心」>「密码管理」>「锁屏密码」，清除原有密码后重新设置。</string>

