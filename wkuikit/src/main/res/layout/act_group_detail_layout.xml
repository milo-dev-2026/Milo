<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/homeColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/wk_title_bar_layout"/>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/refreshLayout"
        android:background="@color/homeColor"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:background="@color/homeColor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/homeColor"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp">

                    <!-- 群成员头像列表 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/userRecyclerView"
                        android:background="@color/homeColor"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- 查看全部成员 -->
                    <TextView
                        android:gravity="center"
                        android:id="@+id/showAllMembersTv"
                        android:background="@color/homeColor"
                        android:paddingBottom="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/show_all_members"/>

                    <!-- 群聊名字 -->
                    <LinearLayout
                        android:id="@+id/groupNameLayout"
                        style="@style/layoutBg">
                        <TextView
                            android:text="@string/group_name"
                            style="@style/leftTextView"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/c787A7E"
                            android:gravity="end"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/nameTv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_weight="2"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"/>
                        <androidx.appcompat.widget.AppCompatImageView style="@style/arrow_right_iv"/>
                    </LinearLayout>

                    <!-- 群头像缩略图 -->
                    <LinearLayout
                        android:id="@+id/groupAvatarLayout"
                        style="@style/layoutBg">
                        <TextView
                            android:text="@string/group_avatar"
                            android:layout_weight="1"
                            style="@style/leftTextView"/>
                        <com.chat.base.ui.components.AvatarView
                            android:id="@+id/groupAvatarIv"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="10dp"/>
                        <androidx.appcompat.widget.AppCompatImageView style="@style/arrow_right_iv"/>
                    </LinearLayout>

                    <!-- 群二维码 -->
                    <LinearLayout
                        android:id="@+id/groupQrLayout"
                        style="@style/layoutBg">
                        <TextView
                            android:text="@string/group_qr"
                            android:layout_weight="1"
                            style="@style/leftTextView"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/mine_qrcode"
                            android:tint="@color/color999"
                            android:layout_marginEnd="5dp"/>
                        <androidx.appcompat.widget.AppCompatImageView style="@style/arrow_right_iv"/>
                    </LinearLayout>

                    <!-- 群公告 -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/noticeLayout"
                        style="@style/layoutBg">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:text="@string/group_announcement"
                                android:layout_weight="1"
                                style="@style/leftTextView"/>
                            <LinearLayout
                                android:id="@+id/unsetNoticeLayout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textColor="@color/c787A7E"
                                    android:layout_gravity="center_vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/unsetting"
                                    android:layout_marginEnd="10dp"/>
                                <androidx.appcompat.widget.AppCompatImageView style="@style/arrow_right_iv"/>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:textSize="16sp"
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/groupNoticeTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="3"
                            android:lineSpacingExtra="4dp"/>
                    </LinearLayout>

                    <!-- 备注 -->
                    <LinearLayout
                        android:id="@+id/remarkLayout"
                        style="@style/layoutBg">
                        <TextView
                            android:text="@string/remark"
                            style="@style/leftTextView"/>
                        <TextView
                            android:ellipsize="end"
                            android:gravity="end"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/remarkTv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:lines="1"
                            android:layout_weight="4"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="10dp"/>
                        <androidx.appcompat.widget.AppCompatImageView style="@style/arrow_right_iv"/>
                    </LinearLayout>

                    <!-- 查找聊天记录 -->
                    <View
                        android:id="@+id/findContentView"
                        android:visibility="gone"
                        style="@style/view_line_padding"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/findContentLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- 群置顶消息 -->
                    <LinearLayout
                        android:id="@+id/pinnedMsgLayout"
                        style="@style/layoutBg">
                        <TextView
                            android:text="@string/pinned_messages"
                            style="@style/leftTextView"/>
                        <androidx.appcompat.widget.AppCompatImageView style="@style/arrow_right_iv"/>
                    </LinearLayout>

                    <!-- 群管理布局（动态添加） -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/groupManageLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- 群管理员入口 -->
                    <LinearLayout
                        android:id="@+id/groupAdminLayout"
                        style="@style/layoutBg">
                        <TextView
                            android:text="@string/group_manager"
                            android:layout_weight="1"
                            style="@style/leftTextView"/>
                        <TextView
                            android:id="@+id/groupAdminCountTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:textColor="@color/c787A7E"
                            android:textSize="16sp"
                            android:layout_marginEnd="10dp"/>
                        <androidx.appcompat.widget.AppCompatImageView style="@style/arrow_right_iv"/>
                    </LinearLayout>

                    <!-- 入群审核入口 -->
                    <LinearLayout
                        android:id="@+id/groupApproveLayout"
                        android:visibility="gone"
                        style="@style/layoutBg">
                        <TextView
                            android:text="@string/group_verify"
                            android:layout_weight="1"
                            style="@style/leftTextView"/>
                        <androidx.appcompat.widget.AppCompatImageView style="@style/arrow_right_iv"/>
                    </LinearLayout>

                    <!-- 消息免打扰 -->
                    <LinearLayout style="@style/layoutBgPaddingSmall">
                        <TextView
                            android:layout_width="0dp"
                            android:text="@string/msg_remind"
                            android:layout_weight="1"
                            style="@style/leftTextView"/>
                        <com.chat.base.ui.components.SwitchView
                            android:id="@+id/muteSwitchView"
                            android:layout_width="50dp"
                            android:layout_height="30dp"/>
                    </LinearLayout>

                    <!-- 置顶聊天 -->
                    <LinearLayout style="@style/layoutBgPaddingSmall">
                        <TextView
                            android:layout_width="0dp"
                            android:text="@string/msg_top"
                            android:layout_weight="1"
                            style="@style/leftTextView"/>
                        <com.chat.base.ui.components.SwitchView
                            android:id="@+id/stickSwitchView"
                            android:layout_width="50dp"
                            android:layout_height="30dp"/>
                    </LinearLayout>

                    <!-- 保存到通讯录 -->
                    <LinearLayout style="@style/layoutBgPaddingSmall">
                        <TextView
                            android:layout_width="0dp"
                            android:text="@string/save_to_maillist"
                            android:layout_weight="1"
                            style="@style/leftTextView"/>
                        <com.chat.base.ui.components.SwitchView
                            android:id="@+id/saveSwitchView"
                            android:layout_width="50dp"
                            android:layout_height="30dp"/>
                    </LinearLayout>

                    <!-- 群密码布局（动态添加） -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/chatPwdView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- 消息设置布局（聊天回执、阅后即焚等，动态添加） -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/msgSettingLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- 我在本群的昵称 -->
                    <LinearLayout
                        android:id="@+id/inGroupNameLayout"
                        style="@style/layoutBg">
                        <TextView
                            android:text="@string/my_remark_name_in_group"
                            style="@style/leftTextView"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/c787A7E"
                            android:gravity="end"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/inGroupNameTv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"/>
                        <androidx.appcompat.widget.AppCompatImageView style="@style/arrow_right_iv"/>
                    </LinearLayout>

                    <!-- 显示群成员昵称（默认隐藏） -->
                    <LinearLayout
                        android:visibility="gone"
                        style="@style/layoutBgPaddingSmall">
                        <TextView
                            android:layout_width="0dp"
                            android:text="@string/show_remark_name"
                            android:layout_weight="1"
                            style="@style/leftTextView"/>
                        <com.chat.base.ui.components.SwitchView
                            android:id="@+id/showNickSwitchView"
                            android:layout_width="50dp"
                            android:layout_height="30dp"/>
                    </LinearLayout>

                    <View style="@style/view_line_padding"/>

                    <!-- 消息提醒设置（动态添加） -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/msgRemindLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- 清空聊天记录 -->
                    <LinearLayout
                        android:layout_gravity="center"
                        android:id="@+id/clearChatMsgLayout"
                        android:background="@drawable/layout_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/color_blue_3F74FC"
                            android:gravity="center"
                            android:padding="15dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/clear_chat_msg"/>
                    </LinearLayout>

                    <View style="@style/view_line_padding"/>

                    <!-- 解散群聊（群主可见） -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/disbandGroupLayout"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/colorFA5151"
                            android:gravity="center"
                            android:background="@drawable/layout_bg"
                            android:padding="15dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/disband_group_chat"/>
                        <View style="@style/view_line_padding"/>
                    </LinearLayout>

                    <!-- 删除并退出 -->
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorFA5151"
                        android:gravity="center"
                        android:id="@+id/exitBtn"
                        android:text="@string/delete_group"
                        style="@style/layoutBg"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</LinearLayout>
