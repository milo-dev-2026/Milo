<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/sh_pop_feed_action"
    android:layout_width="180dp"
    android:layout_height="34dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/like"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/praiseIv"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="1dp"
            android:src="@mipmap/ic_feed_action_like"
            app:tint="@color/white_abs"/>
        <TextView
            android:textSize="@dimen/font_size_14"
            android:textColor="@color/white_abs"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/praiseTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_praise"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <View
        android:layout_gravity="center_vertical"
        android:background="#1f1e1e"
        android:layout_width="1px"
        android:layout_height="15dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/comment"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="2dp"
            android:src="@mipmap/ic_feed_action_comment"
            android:tint="@color/white_abs"/>
        <TextView
            android:textSize="@dimen/font_size_14"
            android:textColor="@color/white_abs"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/str_reply"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
</LinearLayout>
