<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <include layout="@layout/wk_title_bar_layout" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- 标题 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/verify_login_password"
                    android:textColor="@color/colorDark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/verify_login_password_desc"
                    android:textColor="@color/color999"
                    android:textSize="14sp" />

                <!-- 登录密码 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_chat_pwd_input">

                    <EditText
                        android:id="@+id/loginPwdEt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/input_login_password"
                        android:inputType="textPassword"
                        android:maxLength="20"
                        android:paddingStart="16dp"
                        android:paddingEnd="28dp"
                        android:textColor="@color/colorDark"
                        android:textColorHint="#B4B6BD"
                        android:textSize="15sp" />
                </FrameLayout>

                <!-- 聊天密码 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chat_pwd_input">

                    <EditText
                        android:id="@+id/chatPwdEt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/input_chat_password"
                        android:inputType="numberPassword"
                        android:maxLength="6"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/colorDark"
                        android:textColorHint="#B4B6BD"
                        android:textSize="15sp" />
                </FrameLayout>

                <!-- 确认聊天密码 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chat_pwd_input">

                    <EditText
                        android:id="@+id/confirmPwdEt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/input_chat_password_confirm"
                        android:inputType="numberPassword"
                        android:maxLength="6"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/colorDark"
                        android:textColorHint="#B4B6BD"
                        android:textSize="15sp" />
                </FrameLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- 确定按钮 -->
                <TextView
                    android:id="@+id/submitBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_btn_submit_reset"
                    android:gravity="center"
                    android:text="@string/confirm"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:alpha="0.4"
                    android:enabled="false" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>
