<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white_abs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:layout_marginEnd="10dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_msg_avatar"
        android:background="@drawable/ic_launcher_background"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/cardView_msg_content"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/img_msg_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_launcher_background"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:id="@+id/txt_msg_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="User Name"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="150dp"
        app:layout_constraintLeft_toRightOf="@+id/cardView_msg_avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_msg_content"
        android:background="@color/light_transparent"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="100dp"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/cardView_msg_avatar"
        app:layout_constraintLeft_toRightOf="@+id/cardView_msg_avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_msg_name">
        <ImageView
            android:id="@+id/img_msg_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_launcher_background"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
