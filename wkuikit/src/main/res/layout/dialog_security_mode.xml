<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_security_mode_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="22dp"
        android:paddingBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:gravity="center"
            android:id="@+id/titleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/security_mode_dialog_title"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#8f949e"
            android:gravity="center"
            android:id="@+id/contentTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/security_mode_dialog_content"
            android:lineSpacingExtra="2dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/unlockUChatTv"
            android:background="@drawable/bg_security_mode_unlock"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:text="@string/security_mode_unlock_uchat"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/bindPhoneTv"
            android:background="@drawable/bg_security_mode_primary"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="14dp"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/agreementLayout"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:foreground="?attr/selectableItemBackground">
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/agreementCheckBox"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:buttonTint="@color/color_main"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#5e6470"
                android:id="@+id/agreementTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/security_mode_agreement"
                android:includeFontPadding="false"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:gravity="center"
            android:id="@+id/trialUChatTv"
            android:background="@drawable/bg_security_mode_secondary"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#8f949e"
            android:gravity="center"
            android:id="@+id/tipTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="2dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/helpLayout"
            android:background="@drawable/bg_security_mode_secondary"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:foreground="?attr/selectableItemBackground">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#ff0000"
                android:id="@+id/helpQuestionTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/security_mode_help_icon"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:id="@+id/helpTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/security_mode_help"
                android:includeFontPadding="false"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
