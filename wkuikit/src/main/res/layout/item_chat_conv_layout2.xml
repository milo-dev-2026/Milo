<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/conversationLL"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chat.base.ui.components.CheckBox
        android:layout_gravity="center"
        android:id="@+id/checkbox"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="15dp"
        app:color_checked="#fff"
        app:color_checked_bg="@color/color_main"
        app:color_unchecked_bg="@color/transparent"
        app:color_unchecked_stroke="@color/color_grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:size="16dp"
        app:stroke_width="2dp"/>
    <FrameLayout
        android:id="@+id/avatarLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/checkbox"
        app:layout_constraintTop_toTopOf="parent">
        <com.chat.base.ui.components.AvatarView
            android:layout_gravity="center"
            android:id="@+id/avatarView"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/otherLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/groupIV"
        android:visibility="visible"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@mipmap/ic_chat_group"
        app:layout_constraintBottom_toBottomOf="@+id/avatarLayout"
        app:layout_constraintEnd_toEndOf="@+id/avatarLayout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatarLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatarLayout"
        app:layout_constraintTop_toTopOf="@+id/avatarLayout">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorDark"
            android:ellipsize="end"
            android:id="@+id/nameTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/img_group_senior"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth="wrap_content_constrained"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/img_group_senior"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/nameTv"
            app:layout_constraintEnd_toStartOf="@+id/llSvgLayout"
            app:layout_constraintStart_toEndOf="@+id/nameTv"
            app:layout_constraintTop_toTopOf="@+id/nameTv"
            app:layout_constraintWidth="wrap_content_constrained"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llSvgLayout"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="1dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/nameTv"
            app:layout_constraintEnd_toStartOf="@+id/labelLayout"
            app:layout_constraintStart_toEndOf="@+id/img_group_senior"
            app:layout_constraintTop_toTopOf="@+id/nameTv"
            app:layout_constraintWidth="wrap_content_constrained"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/labelLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/nameTv"
            app:layout_constraintEnd_toStartOf="@+id/timeTv"
            app:layout_constraintStart_toEndOf="@+id/llSvgLayout"
            app:layout_constraintTop_toTopOf="@+id/nameTv"
            app:layout_constraintWidth="wrap_content_constrained"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bg_grey_B4B6BD_787A7E"
            android:layout_gravity="center_vertical"
            android:id="@+id/timeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:minHeight="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/remindLayout"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/bg_grey_B4B6BD_787A7E"
                android:ellipsize="end"
                android:id="@+id/contentTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:lines="1"
                android:singleLine="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/forbiddenIv"
                app:layout_constraintStart_toEndOf="@+id/remindLayout"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/forbiddenIv"
                android:visibility="gone"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@mipmap/icon_forbidden"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/rvStatusLayout"
                app:layout_constraintStart_toEndOf="@+id/contentTv"
                app:layout_constraintTop_toTopOf="parent"/>
            <RelativeLayout
                android:id="@+id/rvStatusLayout"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/forbiddenIv"
                app:layout_constraintTop_toTopOf="parent">
                <com.chat.base.ui.view.BadgeTextView
                    android:textSize="12sp"
                    android:textColor="@color/white_abs"
                    android:id="@+id/badgeTextView"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivMute"
                    android:visibility="invisible"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_centerVertical="true"
                    android:layout_alignEnd="@+id/badgeTextView"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="@color/line_color_95fff"
        android:layout_width="0dp"
        android:layout_height="0.6dp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/contentLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
