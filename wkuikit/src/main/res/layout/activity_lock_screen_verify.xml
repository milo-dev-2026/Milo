<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F9"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- 头像 -->
        <com.chat.base.ui.components.AvatarView
            android:id="@+id/avatarIv"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="60dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="锁屏密码"
            android:textColor="#2B313D"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="请输入6位数字密码以解锁并继续使用"
            android:textColor="#787A7E"
            android:textSize="14sp" />

        <!-- 6个密码框 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/dot1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_pwd_box" />
            <ImageView
                android:id="@+id/dot2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_pwd_box" />
            <ImageView
                android:id="@+id/dot3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_pwd_box" />
            <ImageView
                android:id="@+id/dot4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_pwd_box" />
            <ImageView
                android:id="@+id/dot5"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_pwd_box" />
            <ImageView
                android:id="@+id/dot6"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_pwd_box" />
        </LinearLayout>

    </LinearLayout>

    <!-- 数字键盘 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_numpad_btn"
                android:gravity="center"
                android:text="1"
                android:textColor="#2B313D"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_numpad_btn"
                android:gravity="center"
                android:text="2"
                android:textColor="#2B313D"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_numpad_btn"
                android:gravity="center"
                android:text="3"
                android:textColor="#2B313D"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_numpad_btn"
                android:gravity="center"
                android:text="4"
                android:textColor="#2B313D"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_numpad_btn"
                android:gravity="center"
                android:text="5"
                android:textColor="#2B313D"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_numpad_btn"
                android:gravity="center"
                android:text="6"
                android:textColor="#2B313D"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_numpad_btn"
                android:gravity="center"
                android:text="7"
                android:textColor="#2B313D"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_numpad_btn"
                android:gravity="center"
                android:text="8"
                android:textColor="#2B313D"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_numpad_btn"
                android:gravity="center"
                android:text="9"
                android:textColor="#2B313D"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp" />

            <TextView
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_numpad_btn"
                android:gravity="center"
                android:text="0"
                android:textColor="#2B313D"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                    android:id="@+id/btnDeleteBtn"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp"
                    android:gravity="center"
                    android:text="删除"
                    android:textColor="#2B313D"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true" />
        </LinearLayout>

        <!-- 忘记密码 -->
        <TextView
            android:id="@+id/forgetPwdTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="忘记密码"
            android:textColor="#FA5151"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
