<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp">
    <com.chat.base.ui.components.AvatarView
        android:layout_gravity="top"
        android:id="@+id/avatarView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color999"
                android:id="@+id/nameTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color999"
                android:id="@+id/timeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorDark"
            android:id="@+id/contentTv"
            android:background="@drawable/send_chat_text_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>
        <FrameLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:src="@drawable/default_view_bg"
                android:adjustViewBounds="true"/>
            <com.chat.base.views.CircularProgressView
                android:layout_gravity="center"
                android:id="@+id/progressView"
                android:visibility="visible"
                android:layout_width="35dp"
                android:layout_height="35dp"
                app:backColor="@color/white"
                app:backWidth="2dp"
                app:progColor="@color/color999"
                app:progWidth="2dp"
                app:progress="0"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/playIv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@mipmap/icon_play"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/gifIv"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/default_view_bg"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bubbleLayout"
            android:background="@drawable/bg_map"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="70dp"
            app:bubblePadding="0dp"
            app:shadowRadius="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorDark"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/addressTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color999"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/addressDetailTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>
            <com.chat.base.ui.components.FilterImageView
                android:id="@+id/locationCoverIv"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:src="@drawable/default_view_bg"
                android:scaleType="centerCrop"/>
        </LinearLayout>
        <View
            android:id="@+id/viewLine"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            style="@style/view_line"/>
    </LinearLayout>
</LinearLayout>
