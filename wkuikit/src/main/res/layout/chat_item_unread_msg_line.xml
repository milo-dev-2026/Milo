<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/transparent"
    android:paddingTop="@dimen/msg_item_margin"
    android:paddingBottom="@dimen/msg_item_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/colorSystemBg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <View
            android:layout_gravity="center"
            android:background="@color/white_abs"
            android:layout_width="0dp"
            android:layout_height="1px"
            android:layout_weight="1"
            android:layout_marginStart="40dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white_abs"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:text="@string/news_line"
            android:layout_weight="1"/>
        <View
            android:layout_gravity="center"
            android:background="@color/white_abs"
            android:layout_width="0dp"
            android:layout_height="1px"
            android:layout_weight="1"
            android:layout_marginEnd="40dp"/>
    </LinearLayout>
</RelativeLayout>
