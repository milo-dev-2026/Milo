<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout style="@style/layoutBg">
        <com.chat.base.ui.components.AvatarView
            android:layout_gravity="center"
            android:id="@+id/avatarView"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/bannedimg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/icon_banned"/>
        <com.chat.base.ui.components.RoundTextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/roleTv"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/group_admin"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="10dp"
            app:tvBottomLeftRadius="15dp"
            app:tvBottomRightRadius="15dp"
            app:tvTopLeftRadius="15dp"
            app:tvTopRightRadius="15dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorDark"
            android:layout_gravity="center_vertical"
            android:id="@+id/nameTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/removeIv"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@mipmap/icon_remove"/>
    </LinearLayout>
</LinearLayout>
