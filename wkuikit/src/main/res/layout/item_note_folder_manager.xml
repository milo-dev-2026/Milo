<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl"
    android:background="@color/layoutColor"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:paddingStart="16dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/deleteIv"
        android:layout_width="31dp"
        android:layout_height="match_parent"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/ic_delete_red"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/colorDark"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/nameTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/checkIv"
        app:layout_constraintStart_toEndOf="@+id/deleteIv"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/checkIv"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/editIv"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/ic_note_checked"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/editIv"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:tint="@color/colorBBBCBE"
        android:paddingStart="10dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sortIv"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/ic_seat_edit_name"
        app:tint="#528ffa"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sortIv"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@mipmap/ic_manager"/>
    <View
        android:background="@color/line_color_95fff"
        android:layout_width="0dp"
        android:layout_height="0.5px"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/cl"/>
</androidx.constraintlayout.widget.ConstraintLayout>
