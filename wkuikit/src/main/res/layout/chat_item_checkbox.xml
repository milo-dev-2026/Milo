<?xml version="1.0" encoding="utf-8"?>
<com.chat.base.ui.components.CheckBox xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end|bottom"
    android:id="@+id/checkBox"
    android:visibility="visible"
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:layout_marginTop="8dp"
    android:layout_marginStart="-24dp"
    app:color_checked="#fff"
    app:color_checked_bg="@color/color_main"
    app:color_unchecked_bg="@color/transparent"
    app:color_unchecked_stroke="@color/color_grey"
    app:size="20dp"
    app:stroke_width="2dp"/>
