<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@drawable/selector_tab_text_color"
        android:gravity="center"
        android:id="@+id/tabTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white_abs"
        android:gravity="center"
        android:id="@+id/badge"
        android:background="@drawable/bg_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="5dp"
        android:text="99+"
        android:paddingStart="@dimen/dimen_5"
        android:paddingEnd="@dimen/dimen_5"
        android:layout_marginStart="-6dp"
        app:layout_constraintBottom_toTopOf="@+id/tabTitle"
        app:layout_constraintStart_toEndOf="@+id/tabTitle"
        app:layout_constraintTop_toTopOf="@+id/tabTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
