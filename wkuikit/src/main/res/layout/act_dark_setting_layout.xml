<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/homeColor"
        android:orientation="vertical">
    
        <include layout="@layout/wk_title_bar_layout" />
    
        <LinearLayout
            android:id="@+id/topLayout"
            style="@style/layoutBgPaddingSmall"
            android:orientation="vertical">
    
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
    
                <TextView
                    android:id="@+id/systemTv"
                    style="@style/leftTextView"
                    android:text="@string/dark_follow_system" />
    
                <com.chat.base.ui.components.SwitchView
                    android:id="@+id/followSystemSwitch"
                    android:layout_width="45dp"
                    android:layout_height="30dp" />
            </LinearLayout>

</LinearLayout>

    <View android:id="@+id/bottomView" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <FrameLayout android:id="@+id/darkLayout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/darkTv" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/nightIv" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/normalIv" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <FrameLayout android:id="@+id/normalLayout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/normalTv" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
</layout>