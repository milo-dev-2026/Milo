<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivLeftIcon"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/textPrimaryColor"
        android:id="@+id/tvLeftTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/circle_type"
        android:layout_weight="1"
        android:paddingStart="10dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/c787A7E"
        android:id="@+id/tvRightTitle"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="9dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:drawableTint="@color/icon_color_B6BFD5_7D8AAB"/>
    <ImageView
        android:id="@+id/ivRightIcon"
        android:visibility="gone"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="12dp"/>
    <ImageView
        android:id="@+id/ivArrow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
