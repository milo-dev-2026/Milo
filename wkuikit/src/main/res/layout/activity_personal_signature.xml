<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/homeColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/wk_title_bar_layout" />

    <ScrollView
        android:orientation="vertical"
        android:id="@+id/cl_personal_signature"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="16sp"
                android:textColor="@color/colorDark"
                android:textColorHint="@color/color999"
                android:gravity="start|top"
                android:id="@+id/contentEt"
                android:background="@color/layoutColor"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/input_personal_signature"
                android:scrollHorizontally="false"
                android:maxLength="100"
                android:inputType="textMultiLine"
                android:imeOptions="actionDone"
                android:textIsSelectable="false"
                android:textCursorDrawable="@null"
                android:paddingStart="16dp"
                android:paddingEnd="50dp"
                android:paddingVertical="16dp"
                app:layout_constraintEnd_toStartOf="@+id/ivDelete"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDelete"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_search_close"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/contentEt"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/contentEt" />

            <LinearLayout
                android:gravity="end|top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintTop_toBottomOf="@+id/contentEt">

                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_main"
                    android:layout_gravity="end"
                    android:id="@+id/countTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_grey"
                    android:layout_gravity="end"
                    android:id="@+id/totalTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
