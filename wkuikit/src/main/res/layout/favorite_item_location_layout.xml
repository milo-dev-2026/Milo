<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/homeColor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chat.base.ui.components.CheckBox
        android:layout_gravity="center"
        android:id="@+id/checkBox"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="15dp"
        app:color_checked="#fff"
        app:color_checked_bg="@color/color_main"
        app:color_unchecked_bg="@color/transparent"
        app:color_unchecked_stroke="@color/color_grey"
        app:size="20dp"
        app:stroke_width="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentLayout"
        android:background="@drawable/round_bg"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/container"
            android:background="@drawable/bg_map"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@mipmap/icon_location_mark"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/receive_text_color"
                    android:ellipsize="end"
                    android:id="@+id/titleTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/c787A7E"
                    android:ellipsize="end"
                    android:id="@+id/addressTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <com.chat.base.ui.components.AvatarView
                android:layout_gravity="center_vertical"
                android:id="@+id/avatarView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color999"
                android:layout_gravity="center_vertical"
                android:id="@+id/authTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color999"
                android:layout_gravity="center_vertical"
                android:id="@+id/timeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
