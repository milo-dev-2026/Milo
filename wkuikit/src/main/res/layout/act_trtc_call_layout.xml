<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/trtc_call_bg">

    <!-- 隐藏的视频View，保留引用 -->
    <com.tencent.rtmp.ui.TXCloudVideoView
        android:id="@+id/remoteVideoView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <com.tencent.rtmp.ui.TXCloudVideoView
        android:id="@+id/localVideoView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- 最小化按钮（左上角，适配状态栏/灵动岛） -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/minimizeIv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:src="@drawable/icon_minimize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 通话时长（顶部居中） -->
    <TextView
        android:id="@+id/callDurationTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="00:00"
        android:textColor="#333333"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 用户信息区（头像 + 名字），使用 guideline 居中偏上 -->
    <LinearLayout
        android:id="@+id/userInfoLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/bottomLayout"
        app:layout_constraintTop_toTopOf="parent">

        <com.chat.base.ui.components.AvatarView
            android:id="@+id/avatarView"
            android:layout_width="80dp"
            android:layout_height="80dp" />

        <TextView
            android:id="@+id/callerNameTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 底部区域 -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 通话状态文字 -->
        <TextView
            android:id="@+id/callStatusTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:text="等待对方接受邀请..."
            android:textColor="#666666"
        android:textSize="16sp" />

        <!-- 控制按钮区 -->
        <LinearLayout
            android:id="@+id/controlsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 静音按钮 -->
            <LinearLayout
                android:id="@+id/btnMuteLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnMuteMic"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/trtc_btn_bg"
                    android:padding="12dp"
                    android:src="@drawable/icon_mic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="麦克风"
                    android:textColor="#333333"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 免提按钮 -->
            <LinearLayout
                android:id="@+id/btnSpeakerLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnSpeaker"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/trtc_btn_bg"
                    android:padding="12dp"
                    android:src="@drawable/icon_speaker" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="扬声器"
                    android:textColor="#333333"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 挂断按钮 -->
            <LinearLayout
                android:id="@+id/btnHangupLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnHangUp"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/trtc_hangup_bg"
                    android:padding="12dp"
                    android:src="@drawable/icon_hangup" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="挂断"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
