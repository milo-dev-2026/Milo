<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/round_top_bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/title1"
        android:id="@+id/title_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/send_to_this"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/headLl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <com.chat.base.ui.components.AvatarView
            android:layout_gravity="center"
            android:id="@+id/avatarView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/title1"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/nameTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentLl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/imageView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="110dp"
                android:scaleType="centerCrop"
                android:minWidth="100dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/playIv"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@mipmap/icon_play"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/title1"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/contentTv"
            android:background="@drawable/bg_map"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="3dp"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/nodeLL"
            android:background="@drawable/bg_note"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:paddingStart="9dp">
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="9dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:paddingEnd="9dp">
                <com.chat.base.ui.components.FilterImageView
                    android:id="@+id/note_item_headurl"
                    android:visibility="gone"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/default_view_bg"
                    android:scaleType="centerCrop"
                    app:civ_border_color="@color/borderColor"
                    app:civ_border_width="@dimen/chat_border_width"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:textSize="@dimen/font_size_14"
                        android:textColor="@color/title"
                        android:ellipsize="end"
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="@dimen/font_size_12"
                        android:textColor="@color/title"
                        android:ellipsize="end"
                        android:id="@+id/content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:alpha="0.7"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="@color/title"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="3dp"
                android:alpha="0.2"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/font_size_10"
                    android:textColor="@color/title"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/note"
                    android:alpha="0.7"
                    android:layout_marginEnd="7dp"/>
                <TextView
                    android:textSize="@dimen/font_size_10"
                    android:textColor="@color/colorB6CAFF"
                    android:ellipsize="end"
                    android:id="@+id/botom_type_video"
                    android:background="@drawable/bg_round_alpha_fff_2"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wk_video"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"/>
                <TextView
                    android:textSize="@dimen/font_size_10"
                    android:textColor="@color/colorB6CAFF"
                    android:ellipsize="end"
                    android:id="@+id/botom_type_location"
                    android:background="@drawable/bg_round_alpha_fff_2"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/location"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/locationLL"
            android:background="@drawable/bg_map"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@mipmap/icon_location_mark"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/receive_text_color"
                    android:ellipsize="end"
                    android:id="@+id/titleTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/c787A7E"
                    android:ellipsize="end"
                    android:id="@+id/addressTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/title1"
            android:gravity="center"
            android:id="@+id/clearBtn"
            android:background="@drawable/btn_f6f7f9_bg"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:elevation="0dp"/>
        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="16sp"
            android:textColor="@color/title"
            android:gravity="center"
            android:id="@+id/sureBtn"
            android:background="@drawable/btn_3f74fc_shape_bg_select"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/sure"
            android:layout_weight="1"
            android:elevation="0dp"/>
    </LinearLayout>
</LinearLayout>
