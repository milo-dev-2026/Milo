<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/contentLayout"
    style="@style/layoutBg">
    <com.chat.base.ui.components.AvatarView
        android:layout_gravity="center"
        android:id="@+id/avatarView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:is_open_vip="true"/>
    <ImageView
        android:id="@+id/bannedimg"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@mipmap/icon_banned"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.chat.base.ui.components.RoundTextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/roleTv"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_group_members"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginStart="10dp"
                app:tvBackgroundColor="@color/colorAccent"
                app:tvBottomLeftRadius="15dp"
                app:tvBottomRightRadius="15dp"
                app:tvTopLeftRadius="15dp"
                app:tvTopRightRadius="15dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/textPrimaryColor"
                    android:ellipsize="end"
                    android:id="@+id/nameTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:lines="1"
                    android:singleLine="true"
                    android:layout_marginStart="12dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/llSvgLayout"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"
                    app:layout_constraintWidth="wrap_content_constrained"/>
                <LinearLayout
                    android:gravity="start"
                    android:orientation="horizontal"
                    android:id="@+id/llSvgLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/nameTv"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth="wrap_content_constrained"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/font_size_14"
            android:textColor="@color/color999"
            android:id="@+id/timeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
</LinearLayout>
