<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F7F9"
        android:orientation="vertical">

        <include layout="@layout/wk_title_bar_layout" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Hero 卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_reset_pwd_hero"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reset_login_pwd_title"
                        android:textColor="@color/colorDark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/reset_login_pwd_desc"
                        android:textColor="@color/color999"
                        android:textSize="13sp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

                <!-- 表单卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_reset_pwd_form_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 验证方式选择 (仅在都绑定时显示) -->
                    <LinearLayout
                        android:id="@+id/verifyTypeLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_login_tab_container"
                        android:orientation="horizontal"
                        android:padding="4dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/phoneTypeBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/selector_login_tab"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp"
                            android:text="@string/phone_verify"
                            android:textColor="@color/color_main"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/emailTypeBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/selector_login_tab_utalk"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp"
                            android:text="@string/email_verify"
                            android:textColor="@color/color999"
                            android:textSize="15sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <Space
                        android:id="@+id/tabSpace"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:visibility="gone" />

                    <!-- 已绑定账号 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bound_account"
                        android:textColor="@color/colorDark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_outlined_input">

                        <TextView
                            android:id="@+id/accountTv"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/colorDark"
                            android:textSize="15sp" />
                    </FrameLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <!-- 验证码 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/verify_code_label"
                        android:textColor="@color/colorDark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_outlined_input">

                        <EditText
                            android:id="@+id/codeEt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="@string/destroy_code_hint"
                            android:inputType="number"
                            android:maxLength="6"
                            android:paddingStart="16dp"
                            android:paddingEnd="100dp"
                            android:textColor="@color/colorDark"
                            android:textColorHint="@color/color999"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/getCodeBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="end"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/get_verify_code"
                            android:textColor="@color/color_main"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <!-- 新登录密码 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/new_login_password"
                        android:textColor="@color/colorDark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_outlined_input">

                        <EditText
                            android:id="@+id/pwdEt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="@string/new_login_password"
                            android:inputType="textPassword"
                            android:maxLength="20"
                            android:paddingStart="16dp"
                            android:paddingEnd="48dp"
                            android:textColor="@color/colorDark"
                            android:textColorHint="@color/color999"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/visibilityIv"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="end"
                            android:padding="13dp"
                            android:src="@drawable/ic_visibility_off"
                            android:scaleType="centerInside" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/password_rule_tip"
                        android:textColor="@color/color999"
                        android:textSize="12sp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="4dp" />

                <!-- 确定按钮 -->
                <TextView
                    android:id="@+id/submitBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_btn_submit_reset"
                    android:gravity="center"
                    android:text="@string/confirm"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:alpha="0.4"
                    android:enabled="false" />

                <!-- 安全提示 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/verify_code_security_tip"
                    android:textColor="@color/color999"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>
