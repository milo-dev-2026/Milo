<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="end"
    android:orientation="horizontal"
    android:id="@+id/contentLayout"
    android:background="@null"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/videoLayout"
        android:layout_width="100dp"
        android:layout_height="200dp">
        <com.chat.base.ui.components.FilterImageView
            android:id="@+id/imageView"
            android:background="@null"
            android:layout_width="100dp"
            android:layout_height="200dp"
            android:src="@drawable/default_view_bg"
            android:scaleType="centerCrop"
            app:strokeWidth="0dp"
            app:strokeColor="@android:color/transparent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/playIv"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@mipmap/ic_msg_video_play"/>
        <com.chat.base.views.blurview.ShapeBlurView
            android:id="@+id/blurView"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="200dp"
            app:blur_corner_radius="10dp"
            app:blur_mode="rectangle"
            app:blur_radius="10dp"/>
        <View
            android:id="@+id/coverView"
            android:visibility="gone"
            android:background="@drawable/chat_img_conver_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/otherLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/expiredImg"
            android:layout_width="45dp"
            android:layout_height="38dp"
            android:src="@mipmap/media_expired"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.chat.base.views.CircularProgressView
                android:layout_gravity="center"
                android:id="@+id/progressView"
                android:visibility="gone"
                android:layout_width="35dp"
                android:layout_height="35dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white_abs"
                android:id="@+id/progressTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="1.2/12M"/>
        </LinearLayout>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/uploadProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:indeterminateTint="@android:color/white"/>
        <LinearLayout
            android:layout_gravity="end|bottom"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_gravity="end|bottom"
                android:id="@+id/durationTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginEnd="10dp"/>
            <FrameLayout
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginEnd="5dp">
                <include layout="@layout/wk_msg_status_layout"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
