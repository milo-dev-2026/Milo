<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/homeColor"
        android:orientation="vertical">
    
        <include layout="@layout/wk_title_bar_layout" />
    
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:background="@color/homeColor"
            android:orientation="vertical">
    
            <LinearLayout
                android:id="@+id/autoLayout"
                style="@style/layoutBg">
    
                <TextView
                    style="@style/leftTextView"
                    android:text="@string/setting_language_auto" />
    
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/autoIv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:src="@mipmap/msg_check"
                    android:tint="@color/colorAccent" />
            </LinearLayout>

</LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/englishIv" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <FrameLayout android:id="@+id/englishLayout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/simplifiedChineseIv" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <FrameLayout android:id="@+id/simplifiedChineseLayout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
</layout>