<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:padding="10dp"
        style="@style/layoutBg">
        <com.chat.base.ui.components.CheckBox
            android:layout_gravity="center"
            android:id="@+id/checkBox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:color_checked="#fff"
            app:color_checked_bg="@color/color_main"
            app:color_unchecked_bg="@color/transparent"
            app:color_unchecked_stroke="@color/color_grey"
            app:size="20dp"
            app:stroke_width="2dp"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.chat.base.ui.components.AvatarView
                android:layout_gravity="center"
                android:id="@+id/avatarView"
                android:layout_width="54dp"
                android:layout_height="54dp"
                app:is_open_vip="true"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/bannedimgSelected"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/icon_banned"/>
        </FrameLayout>
        <com.chat.base.ui.components.RoundTextView
            android:textSize="@dimen/font_size_14"
            android:textColor="@color/white_abs"
            android:layout_gravity="center_vertical"
            android:id="@+id/roleTv"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="管理员"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:tvBackgroundColor="#ffc107"
            app:tvBottomLeftRadius="15dp"
            app:tvBottomRightRadius="15dp"
            app:tvTopLeftRadius="15dp"
            app:tvTopRightRadius="15dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorDark"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/nameTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_weight="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/llSvgLayout"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth="wrap_content_constrained"/>
            <LinearLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:id="@+id/llSvgLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="16dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/nameTv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/nameTv"
                app:layout_constraintTop_toTopOf="@+id/nameTv"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintWidth="wrap_content_constrained"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
