<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_uchat_trial_bottom_sheet"
    android:paddingTop="24dp"
    android:paddingBottom="32dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="22dp"
    android:paddingEnd="22dp">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/uchat_trial_title"
        android:gravity="center"
        android:id="@+id/titleTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/uchat_trial_text_secondary"
        android:gravity="center"
        android:id="@+id/contentTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/uchat_trial_ended_content"
        android:lineSpacingExtra="2dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/unlockUChatTv"
        android:background="@drawable/bg_security_mode_unlock"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/uchat_trial_ended_unlock"
        android:includeFontPadding="false"
        android:paddingVertical="16dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/openVipTv"
        android:background="@drawable/bg_security_mode_vip"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/uchat_trial_ended_open_vip"
        android:includeFontPadding="false"
        android:paddingVertical="16dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/bindPhoneTv"
        android:background="@drawable/bg_security_mode_primary"
        android:paddingLeft="6dp"
        android:paddingTop="16dp"
        android:paddingRight="6dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:includeFontPadding="false"
        android:paddingHorizontal="6dp"
        android:paddingVertical="16dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/trialUChatTv"
        android:background="@drawable/bg_security_mode_free"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingVertical="16dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/helpLayout"
        android:background="@drawable/bg_uchat_trial_secondary"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:foreground="?attr/selectableItemBackground"
        android:paddingVertical="16dp">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/uchat_trial_help_icon"
            android:id="@+id/helpQuestionTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/security_mode_help_icon"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/uchat_trial_text_primary"
            android:id="@+id/helpTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/security_mode_help"
            android:includeFontPadding="false"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
</LinearLayout>
