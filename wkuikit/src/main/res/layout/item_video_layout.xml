<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/homeColor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chat.base.ui.components.CheckBox
        android:layout_gravity="center"
        android:id="@+id/checkBox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="15dp"
        app:color_checked="#fff"
        app:color_checked_bg="@color/color_main"
        app:color_unchecked_bg="@color/transparent"
        app:color_unchecked_stroke="@color/color_grey"
        app:size="20dp"
        app:stroke_width="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentLayout"
        android:background="@drawable/round_bg"
        android:padding="15dp"
        android:longClickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/default_view_bg"
                android:scaleType="centerCrop"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/playIv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@mipmap/icon_play"/>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <com.chat.base.ui.components.AvatarView
                android:layout_gravity="center_vertical"
                android:id="@+id/avatarView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color999"
                android:layout_gravity="center_vertical"
                android:id="@+id/authTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color999"
                android:layout_gravity="center_vertical"
                android:id="@+id/timeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
