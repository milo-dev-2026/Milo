<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F9"
    android:orientation="vertical">

    <!-- 顶部栏 (48dp, 返回按钮仅在步骤2/3显示) -->
    <FrameLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_login_back"
            android:visibility="gone" />

        <TextView
            android:id="@+id/settingTv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="设置"
            android:textColor="@color/color_main"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="20dp">

            <!-- Logo + 标题区域 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logoIv"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@mipmap/ic_login_logo" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_sign"
                        android:textColor="@color/colorDark"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/subtitleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/login_account_entry_desc"
                        android:textColor="@color/color999"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 24dp间距 -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <!-- 内容卡片 (白色, 20dp圆角) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_card_utalk"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="20dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ViewFlipper
                    android:id="@+id/stepFlipper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- ========== 步骤1: 账号输入 ========== -->
                    <LinearLayout
                        android:id="@+id/step1Layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <!-- Tab切换: 手机号登录 / 邮箱登录 -->
                        <LinearLayout
                            android:id="@+id/tabContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_login_tab_container_utalk"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/phoneTab"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/selector_login_tab_utalk"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="12dp"
                                android:text="@string/choose_login_phone"
                                android:textColor="@color/color_main"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/emailTab"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/selector_login_tab_utalk"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="12dp"
                                android:text="@string/choose_login_mail"
                                android:textColor="@color/color999"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="20dp" />

                        <!-- 手机号输入 (默认显示) -->
                        <FrameLayout
                            android:id="@+id/phoneInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <LinearLayout
                                android:id="@+id/phoneInputBox"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_login_outline_input_normal"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp">

                                <LinearLayout
                                    android:id="@+id/chooseCodeTv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/codeTv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="+86"
                                        android:textColor="@color/colorDark"
                                        android:textSize="17sp" />

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginStart="4dp"
                                        android:src="@drawable/ic_login_dropdown" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="22dp"
                                    android:layout_marginHorizontal="12dp"
                                    android:background="#E5E5E5" />

                                <EditText
                                    android:id="@+id/phoneEt"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@null"
                                    android:hint=""
                                    android:inputType="phone"
                                    android:maxLength="11"
                                    android:textColor="@color/colorDark"
                                    android:textColorHint="@color/color999"
                                    android:textSize="17sp" />
                            </LinearLayout>

                            <!-- 浮动标签 -->
                            <TextView
                                android:id="@+id/phoneLabelTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="-10dp"
                                android:background="@drawable/bg_login_card_utalk"
                                android:paddingHorizontal="6dp"
                                android:text="@string/hint_phone_number"
                                android:textColor="@color/color999"
                                android:textSize="13sp" />
                        </FrameLayout>

                        <!-- 邮箱输入 (默认隐藏) -->
                        <FrameLayout
                            android:id="@+id/emailInputFrame"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:visibility="gone">

                            <EditText
                                android:id="@+id/emailEt"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_login_outline_input_normal"
                                android:hint=""
                                android:inputType="textEmailAddress"
                                android:maxLength="50"
                                android:paddingHorizontal="14dp"
                                android:textColor="@color/colorDark"
                                android:textColorHint="@color/color999"
                                android:textSize="17sp" />

                            <!-- 浮动标签 -->
                            <TextView
                                android:id="@+id/emailLabelTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="-10dp"
                                android:background="@drawable/bg_login_card_utalk"
                                android:paddingHorizontal="6dp"
                                android:text="@string/hint_email_address"
                                android:textColor="@color/color999"
                                android:textSize="13sp" />
                        </FrameLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="16dp" />

                        <!-- 协议勾选 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.chat.base.ui.components.CheckBox
                                android:id="@+id/agreementCb"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/agreeTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sign_in_agree"
                                android:textColor="@color/color999"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/userAgreementTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/user_agreement"
                                android:textColor="@color/color_main"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/agreeMidTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="》《"
                                android:textColor="@color/color999"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/privacyPolicyTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/privacy_policy"
                                android:textColor="@color/color_main"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/agreeEndTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="》"
                                android:textColor="@color/color999"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ========== 步骤2: 已有账号登录 ========== -->
                    <LinearLayout
                        android:id="@+id/step2Layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <!-- 账号显示 (只读) -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <TextView
                                android:id="@+id/accountDisplayTv2"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_login_outline_input_normal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="14dp"
                                android:textColor="@color/colorDark"
                                android:textSize="17sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="-10dp"
                                android:background="@drawable/bg_login_card_utalk"
                                android:paddingHorizontal="6dp"
                                android:text="账号"
                                android:textColor="@color/color999"
                                android:textSize="13sp" />
                        </FrameLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="16dp" />

                        <!-- 密码输入 -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_login_outline_input_normal"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp">

                                <EditText
                                    android:id="@+id/loginPwdEt"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@null"
                                    android:hint=""
                                    android:inputType="textPassword"
                                    android:maxLength="20"
                                    android:textColor="@color/colorDark"
                                    android:textColorHint="@color/color999"
                                    android:textSize="17sp" />

                                <CheckBox
                                    android:id="@+id/loginPwdVisibleCb"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/selector_account_relate_see_password"
                                    android:button="@null" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/loginPwdLabelTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="-10dp"
                                android:background="@drawable/bg_login_card_utalk"
                                android:paddingHorizontal="6dp"
                                android:text="@string/hint_pwd"
                                android:textColor="@color/color999"
                                android:textSize="13sp" />
                        </FrameLayout>

                        <!-- 忘记密码 -->
                        <TextView
                            android:id="@+id/forgetPwdTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:paddingVertical="10dp"
                            android:text="@string/forget_pwd"
                            android:textColor="@color/color_main"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- ========== 步骤3: 新用户注册 ========== -->
                    <LinearLayout
                        android:id="@+id/step3Layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <!-- 账号显示 (只读) -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <TextView
                                android:id="@+id/accountDisplayTv3"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_login_outline_input_normal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="14dp"
                                android:textColor="@color/colorDark"
                                android:textSize="17sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="-10dp"
                                android:background="@drawable/bg_login_card_utalk"
                                android:paddingHorizontal="6dp"
                                android:text="账号"
                                android:textColor="@color/color999"
                                android:textSize="13sp" />
                        </FrameLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="16dp" />

                        <!-- 验证码输入 -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_login_outline_input_normal"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp">

                                <EditText
                                    android:id="@+id/verfiEt"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@null"
                                    android:hint=""
                                    android:inputType="number"
                                    android:maxLength="8"
                                    android:textColor="@color/colorDark"
                                    android:textColorHint="@color/color999"
                                    android:textSize="17sp" />

                                <TextView
                                    android:id="@+id/getVCodeBtn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:paddingHorizontal="10dp"
                                    android:text="@string/get_verf_code"
                                    android:textColor="@color/color_main"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/verfiLabelTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="-10dp"
                                android:background="@drawable/bg_login_card_utalk"
                                android:paddingHorizontal="6dp"
                                android:text="@string/hint_verfi"
                                android:textColor="@color/color999"
                                android:textSize="13sp" />
                        </FrameLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="16dp" />

                        <!-- 密码输入 -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_login_outline_input_normal"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp">

                                <EditText
                                    android:id="@+id/registerPwdEt"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@null"
                                    android:hint=""
                                    android:inputType="textPassword"
                                    android:maxLength="20"
                                    android:textColor="@color/colorDark"
                                    android:textColorHint="@color/color999"
                                    android:textSize="17sp" />

                                <CheckBox
                                    android:id="@+id/registerPwdVisibleCb"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/selector_account_relate_see_password"
                                    android:button="@null" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/registerPwdLabelTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="-10dp"
                                android:background="@drawable/bg_login_card_utalk"
                                android:paddingHorizontal="6dp"
                                android:text="@string/hint_pwd"
                                android:textColor="@color/color999"
                                android:textSize="13sp" />
                        </FrameLayout>

                        <!-- 邀请码 (可选, 默认隐藏) -->
                        <LinearLayout
                            android:id="@+id/inviteLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="16dp" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:clipChildren="false"
                                android:clipToPadding="false">

                                <EditText
                                    android:id="@+id/inviteCodeEt"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:background="@drawable/bg_login_outline_input_normal"
                                    android:hint=""
                                    android:inputType="text"
                                    android:maxLength="20"
                                    android:paddingHorizontal="14dp"
                                    android:textColor="@color/colorDark"
                                    android:textColorHint="@color/color999"
                                    android:textSize="17sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_marginTop="-10dp"
                                    android:background="@drawable/bg_login_card_utalk"
                                    android:paddingHorizontal="6dp"
                                    android:text="@string/hint_invitation_code_optional"
                                    android:textColor="@color/color999"
                                    android:textSize="13sp" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>

                </ViewFlipper>
            </LinearLayout>

            <!-- 24dp间距 -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <!-- 提交按钮 -->
            <TextView
                android:id="@+id/submitBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/selector_login_button"
                android:enabled="false"
                android:gravity="center"
                android:text="@string/login_next_step"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
